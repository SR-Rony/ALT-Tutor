# =============================================================================
# ALT Tutor Frontend — PRODUCTION Environment
# =============================================================================
# VPS / build ব্যবহার:
#   1. YOUR_DOMAIN প্লেসহোল্ডার আসল ডোমেইন দিয়ে বদলান
#   2. Build আগে এই ফাইল project root-এ রাখুন
#   3. চালান:  npm run build && npm run start
#      (Next.js automatically loads .env.production when NODE_ENV=production)
#
# গুরুত্বপূর্ণ: NEXT_PUBLIC_* ভ্যালু build-এর সময় embed হয়।
# URL বদলালে অবশ্যই আবার `npm run build` করতে হবে।
# =============================================================================

# Public site URL (browser)
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.com

# NestJS API base (must include /api)
# Same-domain reverse proxy example: https://YOUR_DOMAIN.com/api
# Separate API subdomain:          https://api.YOUR_DOMAIN.com/api
NEXT_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN.com/api

# Always false in production (use real backend)
NEXT_PUBLIC_USE_MOCK_API=false
